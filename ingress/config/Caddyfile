{
	admin off
	order rate_limit before request_body
	order route last   # 왜: Caddy 는 handle 블록을 경로 길이로 다시 정렬한다. 생성된 경로 표는 route 안에 써서 정렬되지 않게 하고(순서 = 선언에서 만든 특이도 순서), 고정 경로(/healthz·/oauth2/*·/auth/*)가 먼저 처리되도록 route 를 맨 뒤에 둔다   # 속도 제한 모듈(mholt/caddy-ratelimit)의 위치
	# TLS(D88/U5, ADR 0005): gateway 는 HTTPS 필수. 인증서는 Caddy 내부 CA(tls internal)가 기본이고 공인 인증서(ACME)는 GATEWAY_HOSTS 에 도메인을 적고 해당 사이트의 `tls internal` 줄을 지워 전환한다.
	# 평문 포트의 자동 리다이렉트는 쓰지 않고(아래 http:// 사이트가 /healthz 만 평문으로 남기고 나머지를 308 으로 보낸다) 컨테이너 안에서 시스템 신뢰 저장소를 건드리지 않는다.
	auto_https disable_redirects
	skip_install_trust
	# IP 로 접속하는 클라이언트(SNI 없음)에게 내줄 인증서의 이름
	default_sni 127.0.0.1
	# 인증 결과 헤더(X-Auth-Request-*)를 지우는 request_header 가 forward_auth 보다 먼저 돌아야 위조된 헤더가 인증 판정에 남지 않는다(Caddy 기본 순서는 forward_auth 가 앞)
	order request_header before forward_auth
	# 느린 클라이언트(공개 입구, RUNTIME.md R3.17): 요청 헤더를 10초 안에 다 보내지 않거나 유휴 연결이 120초를 넘으면 연결을 닫는다. 값은 표준 관행(Go net/http ReadHeaderTimeout 10초 관행, nginx keepalive_timeout 75초~)에서 잡은 시작값이고 측정 안 함(ADR 0062).
	# 요청 본문 읽기 한도(read_body)는 두지 않는다: 모델 패키지 게시(최대 4GiB tar, 느린 학습 서버 회선)를 전체 시간으로 끊게 된다. 본문은 request_body max_size(바이트 상한)로만 막는다 — R3.17 의 본문 읽기 한도는 미해결(ADR 0062).
	# 쓰기 한도(write)도 두지 않는다: 스트림(text/event-stream, R2.4)과 번들 응답을 전체 시간으로 끊지 않는다.
	servers {
		timeouts {
			read_header 10s
			idle 120s
		}
	}
}
# 토큰은 환경 변수가 아니라 Caddy 표준 파일 치환 {file.{$INGRESS_UPSTREAM_TOKENS_DIR}/<이름>} 으로 읽는다(D84; 설정을 읽을 때 한 번 치환되고 컨테이너 환경에 값이 없다).
# 사람 인증(U82, head ADR 0014, deploy ADR 0057): 직원·운영자·승인자·검토자·저자·의사·admin 을 OIDC(Keycloak + oauth2-proxy)로 인증한다. 정적 계정 파일·basic_auth 는 없다.
# config/gateway-auth.caddy 가 두 조각을 정의한다: (authenticate) = oauth2-proxy 에 묻는 forward_auth, (role_matchers) = 그룹 -> 역할. 이 Caddyfile 의 나머지는 두 조각의 이름만 안다.
import /etc/caddy/gateway-auth.caddy
# 키오스크 기기 인증(D85 F절): (kiosk_devices) 가 @device_ok 를 정의한다. 기기 토큰 목록은 시작할 때 INGRESS_DEVICE_TOKENS_DIR 의 기기별 파일에서 이미지가 만든다(/tmp/openit/devices.caddy).
import /tmp/openit/devices.caddy
# 키오스크 기기 인증(2.3.0, D113, ADR 0040): 게이트웨이가 클라이언트 인증서를 검증하고 주체 CN 을 X-Openit-Device 로 서비스에 넘긴다. 신뢰할 CA 한 개는 파일 설정이다(비밀 아님):
# /etc/caddy/device-tls.caddy 가 (device_client_auth) 를 정의한다. 기본 파일은 비어 있어(검증 꺼짐) 기기 토큰(2.x 호환)만 쓴다. 켜는 법: config/device-tls.mtls.caddy.example, docs/runbook.md 9-2.
import /etc/caddy/device-tls.caddy
# 공개 입구 인증서 출처(ADR 0060): GATEWAY_TLS_MODE 가 internal(기본)·files·acme 중 하나. 파일 하나가 (gateway_tls) 를 정의한다.
import /etc/caddy/gateway-tls/{$GATEWAY_TLS_MODE:internal}.caddy
http://:8080 {
	handle /healthz {
		header Content-Type application/json
		header Cache-Control no-store
		respond `{"status":"ok"}` 200   # R2.3·R5.1: 게이트웨이 자신의 응답. 본문은 HealthStatus(status)
	}
	handle {
		redir https://{host}:{$GATEWAY_PUBLIC_TLS_PORT:8443}{uri} 308
	}
}
# HTTPS 사이트(컨테이너 8443). 사이트 이름 목록은 GATEWAY_HOSTS(기본 localhost, 127.0.0.1). 운영에서는 설치처의 내부 도메인을 적는다(예: kiosk.example.internal:8443).
{$GATEWAY_HOSTS:localhost:8443, 127.0.0.1:8443}, {$GATEWAY_PROBE_SITE:gateway:8443} {   # 뒤의 사이트 이름은 같은 서버의 감시가 부르는 이름이다(GATEWAY_PROBE_SITE, ADR 0060)
	import gateway_tls   # 인증서 출처는 GATEWAY_TLS_MODE(internal|files|acme)가 고른다: config/gateway-tls/<모드>.caddy. 이 파일을 손으로 고치지 않는다
	import kiosk_devices
	# 기기 ID = 검증된 클라이언트 인증서 주체(RFC 2253 문자열, 예: CN=kiosk-1,O=...)의 CN. 형식 ^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$ 를 만족할 때만 기기로 본다(아니면 기기 인증 실패).
	# Caddy 에는 CN 만 내는 플레이스홀더가 없어, 주체 전체를 내부 헤더 X-Openit-Dn 에 항상 덮어쓰고(클라이언트가 보낸 값은 이 줄이 대체한다: 접두어 dn= 때문에 값이 비어 지워질 일이 없다)
	# header_regexp 의 이름 있는 캡처(re.devcn.1)로 CN 을 꺼낸다. X-Openit-Dn 은 서비스로 가기 전에 지운다. 인증서 자체의 신뢰 검증은 TLS 핸드셰이크(client_auth)가 한다.
	request_header X-Openit-Dn "dn={http.request.tls.client.subject}"
	@device_cert header_regexp devcn X-Openit-Dn ^dn=(?:.*,)?CN=([A-Za-z0-9][A-Za-z0-9._:-]{0,127})(?:,|$)
	# 접근 로그: 요청 본문은 남기지 않는다(Caddy는 본문을 기록하지 않는다). Authorization 헤더는 Caddy가 REDACTED로 바꾼다.
	log {
		output stdout
		format json
	}
	# 요청 본문 상한(점검 B4·D5·G3): 사이트 기본 8MiB(계약 상한), 사람이 쓰는 승인·운영·검토 경로 중 **쓰기(POST) 3곳**(승인 결정, 운영자 activate/rollback, 검토 게시)만 1MiB(JSON 몇 줄뿐). 읽기 경로와 직원·저자 경로는 사이트 기본 8MiB. 초과하면 Caddy 가 413 으로 끊는다. 값은 시작값이다.
	request_body {
		max_size 8MiB
	}
	# 보안 헤더(B7): 정적 화면 이미지가 같은 헤더를 이미 붙이더라도 gateway 가 한 곳에서 보장한다. 마이크(STT)를 쓰는 키오스크 때문에 Permissions-Policy 는 두지 않는다.
	# HSTS: HTTPS 필수(D88/U5)이므로 켠다(1년). includeSubDomains/preload 는 도메인이 정해진 뒤에 판단한다.
	# 접두어 ? 는 "이미 있으면 그대로 두고 없을 때만 설정"이다(Caddy 공식 문법). 앱이 같은 이름의 머리글을 정했으면 게이트웨이가 지우거나 바꾸지 않는다(RUNTIME.md R2.1). -Server 는 Caddy 자신의 머리글을 지운다.
	# 왜 한 줄에 하나: 한 header 블록의 ? 항목은 Caddy 가 하나의 "모두 없을 때만" 조건(require)으로 묶어, 앱이 하나라도 정하면 나머지 기본값도 빠진다(2.11.7 에서 확인)
	header ?X-Content-Type-Options nosniff
	header ?X-Frame-Options DENY
	header ?Referrer-Policy no-referrer
	header -Server
	header ?Strict-Transport-Security "max-age=31536000"
	# R10.4: 속도 제한은 로그인·가입 경로에만 둔다(앱 경로에는 429 를 만들지 않는다). 값은 ADR 0002(표준 관행 시작값, 측정 안 함): 클라이언트 주소당 분당 {$LOGIN_RATE_EVENTS:30}회
	rate_limit {
		zone login {
			match {
				path /oauth2/start /oauth2/callback /auth/realms/openit/login-actions/* /auth/realms/openit/protocol/openid-connect/auth
			}
			key {remote_host}
			events {$LOGIN_RATE_EVENTS:30}
			window 1m
		}
	}
	# 기기 설정 파일(/config.json)은 기기마다 그 기기의 정적 서버가 낸다(scripts/kiosk-add-device.sh). 중앙 kiosk-frontend 에는 기기 토큰 파일을 마운트하지 않고, 인증 없는 경로로 새지 않게 여기서도 막는다.
	# 교차 사이트 요청 방어(CSRF, 점검 M2): 상태를 바꾸는 메서드에서 브라우저가 보내는 Sec-Fetch-Site 가 same-origin·none 이 아니거나, Origin 이 이 사이트(https://호스트:포트)와 다르면 403.
	# 브라우저만 이 헤더를 보내므로 curl·서비스 간 호출·E2E 에는 영향이 없다. 키오스크 앱은 같은 출처(gateway 가 낸 화면)라 통과한다. 헤더가 없는 요청은 막지 않는다(브라우저 밖 클라이언트).
	# L20(ADR 0056): 허용 출처는 GATEWAY_HOSTS 에서 만든다. 요청 Host 의 호스트 이름이 GATEWAY_HOST_NAMES(lib.sh 가 GATEWAY_HOSTS 에서 포트를 떼어 만든 목록) 안에 있어야 하고, Origin 은 정확히 https://<Host 의 host:port> 여야 한다.
	# 포트는 목록에서 고정하지 않는다: 밖에 게시된 포트가 컨테이너 포트(8443)와 다를 수 있고(데모·E2E 는 Docker 배정 포트) 브라우저가 보내는 Host 의 포트가 실제 출처의 포트이기 때문이다. 다른 포트의 같은 호스트(다른 출처)는 Origin 과 Host 가 달라 막힌다.
	# 본문이 상한(8MiB)을 넘는다고 Content-Length 가 알리면 상류로 보내기 전에 413 으로 거절한다. request_body max_size 만으로는 상류가 TLS 사이드카일 때 본문을 읽다 끊긴 오류가 413 이 아니라
	# 502 로 올라와 아래 handle_errors 가 503 UPSTREAM_UNAVAILABLE 로 바꿨다(4차 E2E 5a: 8MiB 초과 본문이 503). Content-Length 가 없는(chunked) 요청은 request_body 가 계속 막는다.
	@toolarge expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 8388608`
	handle @toolarge {
		header Content-Type application/json
		header Cache-Control no-store
		respond `{"pipeline_schema_version":"{$PIPELINE_SCHEMA_VERSION}","code":"INVALID_RECORD","message":"request body too large","retryable":false,"details":{"max_body_bytes":8388608}}` 413
	}
	@csrf expression `{http.request.method} in ["POST", "PUT", "PATCH", "DELETE"] && (({http.request.header.Sec-Fetch-Site} != "" && !({http.request.header.Sec-Fetch-Site} in ["same-origin", "none"])) || ({http.request.header.Origin} != "" && (!({http.request.host} in [{$GATEWAY_HOST_NAMES}]) || {http.request.header.Origin} != "https://" + {http.request.hostport})))`
	handle @csrf {
		header Content-Type application/json
		header Cache-Control no-store
		respond `{"pipeline_schema_version":"{$PIPELINE_SCHEMA_VERSION}","code":"PERMISSION_DENIED","message":"cross-origin request denied","retryable":false}` 403
	}
	handle /config.json {
		header Content-Type application/json
		respond `{"pipeline_schema_version":"{$PIPELINE_SCHEMA_VERSION}","code":"NOT_FOUND","message":"not found","retryable":false}` 404
	}
	handle /healthz {
		header Content-Type application/json
		header Cache-Control no-store
		respond `{"status":"ok"}` 200   # R2.3·R5.1: 게이트웨이 자신의 응답. 본문은 HealthStatus(status)
	}
	# /readyz: 환자 경로의 survey-service /readyz 를 반영한다(FAULT_POLICY 5). 2xx 면 {"status":"ok"} 200, 아니면 서비스의 상태 코드를 그대로 두되 본문은 {"status":"not-ready"} 만(서비스의 내부 문제 목록은 밖에 내지 않는다).
	# 상류에 닿지 못하면 아래 handle_errors 가 503/504 와 UPSTREAM_UNAVAILABLE 을 준다. /healthz 는 상류와 무관한 정적 200.
	handle /readyz {
		reverse_proxy https://survey-service {
			header_up X-Forwarded-Host {http.request.hostport}   # 왜: 사이드카가 X-Forwarded-* 를 이웃(사설망)에게서 그대로 받는다(trusted_proxies). 원래 Host 를 앱이 알아야 하는 서비스(Keycloak)용
			header_up Host {upstream_hostport}   # 왜: 상류 사이드카는 서비스 이름 사이트로 TLS 를 끝낸다(Host 로 사이트를 고른다). 원래 Host 는 X-Forwarded-Host 로 남는다
				header_up -X-Openit-Dn
				header_up -X-Openit-Device   # 클라이언트가 보낸 기기 헤더는 항상 지운다(게이트웨이만 인증서에서 붙인다, 계약 PUBLIC_API F절)
			header_up -X-Openit-User   # 공개 /readyz 에 클라이언트의 사용자 헤더·자격을 넘기지 않는다(점검 L1)
			header_up -X-Openit-Roles
			header_up -Authorization
			lb_try_duration 0
			transport http {
				tls_trusted_ca_certs {$INGRESS_ROOT_CA}   # 서비스 사이드카 인증서는 deploy step-ca 가 발급한다: 루트만 신뢰(ADR 0060)
				dial_timeout 1s
				response_header_timeout 2s
			}
			@up status 2xx
			handle_response @up {
				header Content-Type application/json
				header Cache-Control no-store
				respond `{"status":"ready"}` 200
			}
			handle_response {
				header Content-Type application/json
				header Cache-Control no-store
				respond `{"status":"not_ready"}` {rp.status_code}
			}
		}
	}
	# 사람 인증 경로(U82, ADR 0057): /oauth2/* 는 oauth2-proxy(로그인 시작·콜백·로그아웃·/oauth2/userinfo), /auth/* 는 Keycloak(KC_HTTP_RELATIVE_PATH=/auth: 로그인·가입 화면, realm openit 의 관리 화면).
	# 로그인 자체라 인증 없이 열린다. /oauth2/auth 는 gateway 가 forward_auth 로 안에서만 부르는 길이라 밖에는 닫는다. Keycloak 의 master realm(부트스트랩 관리자)은 밖에 열지 않는다: 관리는 realm openit 의 admin 그룹 계정으로 한다.
	@oauth2internal path /oauth2/auth
	handle @oauth2internal {
		header Content-Type application/json
		respond `{"pipeline_schema_version":"{$PIPELINE_SCHEMA_VERSION}","code":"NOT_FOUND","message":"not found","retryable":false}` 404
	}
	# /oauth2/* 와 /auth/* 의 프록시는 내장 선언(ingress/exposures-builtin/)에서 생성된다. 위·아래의 두 닫힘(/oauth2/auth, master realm)이 그보다 먼저 걸린다
	@kcmaster path /auth/realms/master /auth/realms/master/* /auth/admin/master /auth/admin/master/*
	handle @kcmaster {
		header Content-Type application/json
		respond `{"pipeline_schema_version":"{$PIPELINE_SCHEMA_VERSION}","code":"NOT_FOUND","message":"not found","retryable":false}` 404
	}
	# 영역 경로 표: 각 영역의 Exposure 선언에서 생성한다(ingress/gen-ingress-routes.py, S9). 손으로 쓴 영역 경로는 없다.
	import /tmp/openit/routes.caddy
	handle_errors {
		@authdown expression `{vars.auth_phase} == "checking"`
		handle @authdown {
			header Content-Type application/json
			header Retry-After 5
			header Cache-Control no-store
			respond `{"pipeline_schema_version":"{$PIPELINE_SCHEMA_VERSION}","code":"UNAVAILABLE","message":"authentication check unavailable","retryable":true}` 503
		}
		@refused expression {http.error.status_code} in [502, 503]
		@timedout expression {http.error.status_code} == 504
		@toomany expression {http.error.status_code} == 429
		@longuri expression {http.error.status_code} in [414, 431]
		handle @refused {
			header Content-Type application/json
			header Retry-After 5
			header Cache-Control no-store
			respond `{"code":"UPSTREAM_UNAVAILABLE"}` 503
		}
		handle @timedout {
			header Content-Type application/json
			header Retry-After 5
			header Cache-Control no-store
			respond `{"code":"UPSTREAM_UNAVAILABLE"}` 504
		}
		# R10.4: 속도 제한(로그인·가입·기기 등록 경로만)을 넘으면 429 + Retry-After(모듈이 정한다), 본문은 BoundaryError 전체 필드
		handle @toomany {
			header Content-Type application/json
			header Cache-Control no-store
			respond `{"pipeline_schema_version":"{$PIPELINE_SCHEMA_VERSION}","code":"UNAVAILABLE","message":"too many requests","retryable":true}` 429
		}
		handle @longuri {
			header Content-Type application/json
			respond `{"pipeline_schema_version":"{$PIPELINE_SCHEMA_VERSION}","code":"INVALID_RECORD","message":"request line or headers too large","retryable":false}` {http.error.status_code}
		}
	}
}
