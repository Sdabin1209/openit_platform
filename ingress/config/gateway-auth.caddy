# 사람 인증 조각(platform 공개 입구, ADR 0002): 쿠키 세션은 oauth2-proxy 가 만들고 Caddy 는 forward_auth 로 묻는다. 정적 계정 파일·basic_auth 는 없다.
# (authenticate): 세션이 없으면 R3.23(/v1/ 401 BoundaryError, 화면 302, 그 밖 비 html 401, 모든 401 에 WWW-Authenticate: Bearer realm="openit"), 인증 확인이 느리거나 5xx 면 R3.12(503 UU).
# 역할 판정(R3.24)과 가입 승인 대기(ACCOUNT_PENDING_APPROVAL)는 경로마다 생성되는 코드(ingress/gen-ingress-routes.py)가 한다: Exposure.auth.roles 에서 만든다.
(authenticate) {
	vars auth_phase checking   # 왜: 인증 확인(forward_auth)이 시간 초과·연결 실패로 끝나면 handle_errors 가 이 값으로 504 가 아니라 503 UU 를 고른다(R3.12)
	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Preferred-Username
	request_header -X-Auth-Request-Groups
	forward_auth https://identity-proxy {
		header_up Host {upstream_hostport}
		transport http {
			tls_trusted_ca_certs {$INGRESS_ROOT_CA}
			dial_timeout 1s
			response_header_timeout {$AUTH_CHECK_TIMEOUT:2s}   # R3.12: 인증 확인이 이 한도를 넘으면 503 UU(401·로그인 화면 이동 아님). 값은 ADR 0002(측정 안 함)
		}
		uri /oauth2/auth
		copy_headers X-Auth-Request-User X-Auth-Request-Preferred-Username X-Auth-Request-Groups
		# 세션이 없으면(R3.23): /v1/ 은 401 BoundaryError, 화면은 로그인으로 302, 그 밖의 비 html 요청은 401. 모든 401 은 WWW-Authenticate: Bearer realm="openit"
		@unauthenticated status 401
		handle_response @unauthenticated {
			@api path /v1/*
			@html header Accept *text/html*
			handle @api {
				header Content-Type application/json
				header Cache-Control no-store
				header WWW-Authenticate `Bearer realm="openit"`
				respond `{"pipeline_schema_version":"{$PIPELINE_SCHEMA_VERSION}","code":"PERMISSION_DENIED","message":"login required","retryable":false}` 401
			}
			handle @html {
				redir * /oauth2/start?rd={http.request.uri.path} 302
			}
			handle {
				header Content-Type application/json
				header Cache-Control no-store
				header WWW-Authenticate `Bearer realm="openit"`
				respond `{"pipeline_schema_version":"{$PIPELINE_SCHEMA_VERSION}","code":"PERMISSION_DENIED","message":"login required","retryable":false}` 401
			}
		}
		# 인증 확인이 정상 응답(2xx·401)이 아니면(계정 관리가 BoundaryError 가 아닌 5xx 등) 503 UU 로 바꾼다. 오류 본문은 호출자에게 가지 않는다(R3.12)
		@authfail status 3xx 4xx 5xx   # 401 은 위에서 먼저 처리한다
		handle_response @authfail {
			header Content-Type application/json
			header Cache-Control no-store
			header Retry-After 5
			respond `{"code":"UPSTREAM_UNAVAILABLE"}` 503
		}
	}
	vars auth_phase done
}
