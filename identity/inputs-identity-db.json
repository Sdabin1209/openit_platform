{
  "schema_version": 1,
  "image": "identity-db",
  "read_only_root": true,
  "exec_absolute_argv": true,
  "role_env": null,
  "roles": {
    "default": {
      "env_schema": "AreaDatabaseEnv",
      "process": {
        "uid": 999,
        "gid": 999
      },
      "files": [
        {
          "path_env": null,
          "path": "/certs",
          "directory": true,
          "kind": "certificate",
          "schema": null,
          "required": true,
          "opened_by": "start-process"
        },
        {
          "path_env": null,
          "path": "/run/secrets/db/identity",
          "directory": false,
          "kind": "secret",
          "schema": null,
          "required": true,
          "opened_by": "start-process"
        },
        {
          "path_env": "POSTGRES_PASSWORD_FILE",
          "path": "/run/secrets/pg-superuser-identity",
          "directory": false,
          "kind": "secret",
          "schema": null,
          "required": true,
          "opened_by": "start-process"
        },
        {
          "path_env": "DB_ACCOUNT_SECRETS_DIR",
          "path": "/run/secrets/db",
          "directory": true,
          "kind": "secret",
          "schema": null,
          "required": true,
          "opened_by": "start-process"
        }
      ],
      "writable": [
        {
          "path": "/tmp",
          "persist": false,
          "written_by": {
            "uid": 999,
            "gid": 999
          }
        },
        {
          "path": "/var/lib/postgresql/data",
          "persist": true,
          "written_by": {
            "uid": 999,
            "gid": 999
          }
        },
        {
          "path": "/var/run/postgresql",
          "persist": false,
          "written_by": {
            "uid": 999,
            "gid": 999
          }
        }
      ],
      "capabilities": [],
      "sysctls": {}
    }
  },
  "jobs": {
    "backup": {
      "env_schema": "IdentityDatabaseBackupEnv",
      "process": {
        "uid": 999,
        "gid": 999
      },
      "files": [
        {
          "path_env": "SSL_CERT_FILE",
          "path": "/etc/openit/pki/root_ca.crt",
          "directory": false,
          "kind": "ca-bundle",
          "schema": null,
          "required": true,
          "opened_by": "start-process"
        },
        {
          "path_env": "OPENIT_BACKUP_CREDENTIALS_FILE",
          "path": "/run/secrets/backup-identity-credentials",
          "directory": false,
          "kind": "secret",
          "schema": null,
          "required": true,
          "opened_by": "start-process"
        },
        {
          "path_env": "OPENIT_BACKUP_REPO_PASSWORD_FILE",
          "path": "/run/secrets/backup-identity-repo-password",
          "directory": false,
          "kind": "secret",
          "schema": null,
          "required": true,
          "opened_by": "start-process"
        },
        {
          "path_env": null,
          "path": "/run/secrets/identity-db-url",
          "directory": false,
          "kind": "secret",
          "schema": null,
          "required": true,
          "opened_by": "start-process"
        }
      ],
      "writable": [
        {
          "path": "/tmp",
          "persist": false,
          "written_by": {
            "uid": 999,
            "gid": 999
          }
        }
      ],
      "capabilities": [],
      "sysctls": {}
    },
    "restore": {
      "env_schema": "IdentityDatabaseBackupEnv",
      "process": {
        "uid": 999,
        "gid": 999
      },
      "files": [
        {
          "path_env": "SSL_CERT_FILE",
          "path": "/etc/openit/pki/root_ca.crt",
          "directory": false,
          "kind": "ca-bundle",
          "schema": null,
          "required": true,
          "opened_by": "start-process"
        },
        {
          "path_env": "OPENIT_BACKUP_CREDENTIALS_FILE",
          "path": "/run/secrets/backup-identity-credentials",
          "directory": false,
          "kind": "secret",
          "schema": null,
          "required": true,
          "opened_by": "start-process"
        },
        {
          "path_env": "OPENIT_BACKUP_REPO_PASSWORD_FILE",
          "path": "/run/secrets/backup-identity-repo-password",
          "directory": false,
          "kind": "secret",
          "schema": null,
          "required": true,
          "opened_by": "start-process"
        },
        {
          "path_env": null,
          "path": "/run/secrets/identity-db-url",
          "directory": false,
          "kind": "secret",
          "schema": null,
          "required": true,
          "opened_by": "start-process"
        }
      ],
      "writable": [
        {
          "path": "/tmp",
          "persist": false,
          "written_by": {
            "uid": 999,
            "gid": 999
          }
        }
      ],
      "capabilities": [],
      "sysctls": {}
    }
  }
}
