# platform 사람 인증 DB identity-db(공식 postgres:16 위, D126: DB 초기화는 그 데이터 주인의 이미지 안). 입력은 계약 AreaDatabaseEnv 뿐이다: 계정·권한·접속 규칙(pg_hba)·TLS 는 이미지가 DatabaseDeclaration(라벨 io.openit.database)대로 만든다.
ARG POSTGRES_IMAGE=docker.io/library/postgres@sha256:9e2cf6287f25c3151f4c9421ccce2b17f3e60061c111a29165e0d2cdd9ff0a97
ARG RESTIC_IMAGE=docker.io/restic/restic@sha256:4cf4a61ef9786f4de53e9de8c8f5c040f33830eb0a10bf3d614410ee2fcb6120
ARG GO_BUILDER=docker.io/library/caddy@sha256:c4cd20eaa0b69112fd5d4f721ffc9671687e1d5d0b155c8620cf7546dbef94c0
FROM ${GO_BUILDER} AS envcheck
COPY --from=common . /src/
RUN cd /src && CGO_ENABLED=0 go build -trimpath -buildvcs=false -o /envcheck ./cmd/envcheck
FROM ${RESTIC_IMAGE} AS restic
FROM ${POSTGRES_IMAGE}
ARG COMMIT=unknown
ARG BOUNDARY_TAG=unknown
ARG JOBS_JSON
COPY --from=envcheck /envcheck /usr/local/bin/envcheck
# 오프라인 검증은 전이 참조(_common·CommonEnv·잡 Env 포함)까지 필요하므로 계약 패키지의 스키마 묶음을 함께 넣는다.
COPY --from=boundary_contracts boundary_contracts/schemas/ /etc/openit/schemas/
# 데이터 주인 백업·복구 잡(RUNTIME R10.1): 이미지가 pg_dump·pg_restore 와 restic 을 갖고 라벨 io.openit.jobs 로 잡을 낸다(정본 identity/jobs-identity-db.json)
COPY --from=restic /usr/bin/restic /usr/local/bin/restic
COPY --from=common --chmod=755 backup-job.sh /usr/local/bin/platform-backup-job
COPY db/database.json /etc/openit/database.json
COPY --chmod=755 db/entrypoint.sh /usr/local/bin/identity-db-entrypoint.sh
COPY --chmod=755 db/10-accounts.sh /docker-entrypoint-initdb.d/10-accounts.sh
LABEL io.openit.jobs="${JOBS_JSON}" io.openit.service="identity-db" io.openit.revision="${COMMIT}" io.openit.contracts.boundary="${BOUNDARY_TAG}" io.openit.contracts.survey-schema="n/a" io.openit.model-runtime="n/a" \
      io.openit.database='{"engine":"postgresql","major":16,"port":5432,"accounts":[{"name":"identity","database":"identity","privilege":"owner","url_env":["IDENTITY_DB_URL_FILE"]}]}'
# 건강 확인(Docker 표준 HEALTHCHECK): 선언 계정으로 TLS 접속이 되는지 본다(배치가 pg_isready 로 대신 확인하지 않는다). 시작 유예 60초는 initdb·계정 생성 시간의 여유값이고 측정하지 않았다
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=3 CMD ["/usr/local/bin/identity-db-entrypoint.sh", "health"]
USER postgres
ENTRYPOINT ["/usr/local/bin/identity-db-entrypoint.sh"]
CMD ["postgres"]
